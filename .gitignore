.DS_Store
.thumbs.db
node_modules
/dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*
mongo-data*
# MongoDB data folder (bind mount of the mongodb container): the folder is in git, it must exist for the mount (some Docker
# hosts do not create it); its content (data of the instance) never
!mongodb/mongo-data/
mongodb/mongo-data/*
!mongodb/mongo-data/.gitignore
.quasar
report-templates
custom-generator.js
dist
# Configuration files
config.json
report.json
roles.json
app-settings.json
backend/src/config/config.json
docker-compose.override.yml

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln

# Version managers
.tool-versions
# Backups stored by the application (bind mount of the backend container): the folder is in git, it must exist for the
# mount (some Docker hosts do not create it); its content (data of the instance) never
backend/backup/*
!backend/backup/.gitignore
